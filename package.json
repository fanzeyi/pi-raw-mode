{
  "name": "pi-raw-mode",
  "version": "0.1.0",
  "description": "Codex-inspired /raw mode for literal, zero-padding assistant output in the Pi TUI",
  "type": "module",
  "license": "MIT",
  "author": "Zeyi (Rice) Fan",
  "homepage": "https://github.com/fanzeyi/pi-raw-mode#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fanzeyi/pi-raw-mode.git"
  },
  "bugs": {
    "url": "https://github.com/fanzeyi/pi-raw-mode/issues"
  },
  "keywords": [
    "pi-package",
    "pi-coding-agent",
    "pi-extension",
    "raw-mode",
    "openai-codex",
    "markdown",
    "terminal",
    "tui",
    "clipboard"
  ],
  "files": [
    "extensions",
    "CHANGELOG.md",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "typecheck": "tsc --noEmit",
    "smoke": "node tests/smoke.mjs",
    "check": "npm run typecheck && npm test && npm run smoke",
    "pack:dry-run": "npm pack --dry-run"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "^0.84.1",
    "@earendil-works/pi-coding-agent": "^0.84.1",
    "@earendil-works/pi-tui": "^0.84.1",
    "@types/node": "^24.0.0",
    "typescript": "^5.9.3"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "pi": {
    "extensions": [
      "./extensions/index.ts"
    ]
  }
}
